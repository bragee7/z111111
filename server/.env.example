# Server configuration
PORT=5000
DATABASE_URL=
DB_SSL=true
JWT_SECRET=

# Supabase (media storage)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Email (SendGrid)
SENDGRID_API_KEY=
