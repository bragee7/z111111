# Server configuration
PORT=5000
DATABASE_URL=
DB_SSL=true
# Required outside local development. Generate with: openssl rand -hex 32
JWT_SECRET=

# Optional comma-separated extra browser origins allowed by CORS
CORS_ORIGINS=

# Supabase (media storage)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Email (SendGrid)
SENDGRID_API_KEY=
EMAIL_FROM=ZELDA <noreply@guardian.com>
POLICE_EMAIL=police@guardian.com

# Nearest police station — Tamil Nadu (OSM Overpass, backend-only)
POLICE_STATION_ENABLED=true
POLICE_STATION_RADIUS_M=5000
POLICE_STATION_OVERPASS_URL=https://overpass-api.de/api/interpreter
POLICE_STATION_TIMEOUT_MS=3500

# Rate limiting (F4) - optional overrides
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=300

# Neon Postgres (recommended). Paste the pooled connection string from Neon.
# DATABASE_URL=postgres://user:pass@ep-xxx.region.aws.neon.tech/db?sslmode=require
# DB_SSL=true

# Cloudflare R2 (optional object storage for SOS media)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=sos-media
# R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev
# R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com

# Backblaze B2 (recommended no-card object storage for SOS evidence)
# Create a bucket-scoped Application Key with listFiles, readFiles, writeFiles, deleteFiles.
# B2_KEY_ID=
# B2_APPLICATION_KEY=
# B2_BUCKET=zeldadb
# B2_REGION=us-east-005
# B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
# Optional public base URL only if the bucket is public:
# B2_PUBLIC_BASE_URL=https://f005.backblazeb2.com/file/zeldadb