# Nearest police station — Tamil Nadu (OSM Overpass, backend-only)
POLICE_STATION_ENABLED=true
POLICE_STATION_RADIUS_M=5000
POLICE_STATION_OVERPASS_URL=https://overpass-api.de/api/interpreter
POLICE_STATION_TIMEOUT_MS=3500

# Rate limiting (F4) - optional overrides
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=300
